{
  // Windows Terminal settings - install.ps1 copies this to every Terminal that is
  // installed (the built-in one and Terminal Preview from the Store). Edit THIS
  // copy: Terminal rewrites the live file, dropping these comments, whenever a
  // setting is changed in its UI. scripts\doctor.ps1 warns when they differ.
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",

  // PowerShell 7. Terminal's PowershellCore generator names the profile it finds
  // - including the Store/MSIX PowerShell Preview build - plain "PowerShell".
  // Older Terminal builds named the MSIX one "PowerShell Preview (msix)", and a
  // name that matches no profile is NOT an error: Terminal falls back to Windows
  // PowerShell 5.1, which reads a different profile directory and looks like
  // "none of my config applied". If a new tab opens the wrong shell, read the
  // name off Settings > Startup > Default profile and put it here.
  // defaultProfile accepts either a GUID or a profile name.
  "defaultProfile": "PowerShell",

  "theme": "light",
  "copyOnSelect": true,
  // Renamed by Terminal: the bare "confirmCloseAllTabs" is silently ignored.
  "warning.confirmCloseAllTabs": false,
  "initialCols": 125,
  "initialRows": 30,
  "disabledProfileSources": ["Windows.Terminal.Azure"],

  "profiles": {
    "defaults": {
      "colorScheme": "Catppuccin Latte",
      // Ghostty ran minimum-contrast = 1.1 for the same reason: a few Latte
      // accents sit close to the light background.
      "adjustIndistinguishableColors": "always",
      "font": {
        // Nerd Fonts' build of Cascadia Code. The installed FAMILY name changed
        // in Nerd Fonts v3.4: it is "CaskaydiaCove NF" now and was
        // "CaskaydiaCove Nerd Font" before, so both are listed. A name that
        // matches nothing falls back to another font without any error, which is
        // why this is a list and not one string. Terminal 1.16+ reads a
        // comma-separated face as a fallback chain; Cascadia Mono ships with
        // Windows and is the last resort (no icons, but nothing breaks).
        //
        // Check what is actually installed with:
        //   (New-Object System.Drawing.Text.InstalledFontCollection).Families |
        //       Where-Object Name -like 'Caskaydia*'
        // NF keeps the icons' natural width; NFM forces every glyph to one cell
        // and NFP spaces them proportionally - neither is wanted here.
        //
        // No cellHeight: Ghostty's adjust-cell-height = 8% ADDS to the font's own
        // line height, while Terminal's cellHeight is an absolute multiple of the
        // font size. Copying 1.08 would make lines tighter, not looser.
        "face": "CaskaydiaCove NF, CaskaydiaCove Nerd Font, Cascadia Mono",
        "size": 10,
        "features": { "calt": 1, "zero": 1, "ss01": 1, "ss02": 1, "ss20": 1 }
      },
      "padding": "10, 8",
      "cursorShape": "bar",
      "historySize": 100000,
      // No background image and no acrylic: the point is a flat, uniform
      // Catppuccin Latte surface, the same one the Linux side had in Ghostty.
      // Anything behind the text costs contrast against Latte's dark #4C4F69
      // foreground. The desktop wallpaper is a separate thing - install.ps1
      // sets it, see config\shared\wallpaper.
      "useAcrylic": false
    },

    // NOT empty, despite the temptation. Terminal does NOT populate an empty
    // list for you: it loads the file, finds zero profiles, reports "All
    // profiles were hidden in your settings" and falls back to its built-in
    // defaults - so none of the settings above apply either. Listing at least
    // one real profile breaks that deadlock, and Terminal then adds the ones it
    // generates itself (Git Bash, WSL distros, Visual Studio) on the next start.
    //
    // These three GUIDs are fixed values, the same on every Windows machine:
    // the two inbox profiles, and the one Terminal derives for PowerShell 7.
    // Naming the PowerShell 7 entry here is also what makes "defaultProfile":
    // "PowerShell" above resolve no matter what a given Terminal build would
    // have called it.
    "list": [
      {
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "source": "Windows.Terminal.PowershellCore",
        "name": "PowerShell",
        "hidden": false
      },
      {
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "name": "Windows PowerShell",
        "hidden": false
      },
      {
        "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
        "name": "Command Prompt",
        "hidden": false
      }
    ]
  },

  // From github.com/catppuccin/windows-terminal (latte.json).
  "schemes": [
    {
      "name": "Catppuccin Latte",
      "cursorColor": "#DC8A78",
      "selectionBackground": "#ACB0BE",
      "background": "#EFF1F5",
      "foreground": "#4C4F69",
      "black": "#5C5F77",
      "red": "#D20F39",
      "green": "#40A02B",
      "yellow": "#DF8E1D",
      "blue": "#1E66F5",
      "purple": "#EA76CB",
      "cyan": "#179299",
      "white": "#ACB0BE",
      "brightBlack": "#ACB0BE",
      "brightRed": "#D20F39",
      "brightGreen": "#40A02B",
      "brightYellow": "#DF8E1D",
      "brightBlue": "#1E66F5",
      "brightPurple": "#EA76CB",
      "brightCyan": "#179299",
      "brightWhite": "#BCC0CC"
    }
  ],

  // Only the Ghostty/Konsole bindings Terminal does not already have. Its defaults
  // cover ctrl+shift+t/n/w, ctrl+tab, ctrl+shift+c/v, F11 and ctrl+=/-/0.
  //
  // NB: ctrl+shift+arrows replaces Terminal's scroll-by-line binding, and alt+1..4
  // shadows PSReadLine's digit-argument keys - the same trade Ghostty made.
  "actions": [
    { "command": { "action": "switchToTab", "index": 0 }, "id": "User.switchToTab0" },
    { "command": { "action": "switchToTab", "index": 1 }, "id": "User.switchToTab1" },
    { "command": { "action": "switchToTab", "index": 2 }, "id": "User.switchToTab2" },
    { "command": { "action": "switchToTab", "index": 3 }, "id": "User.switchToTab3" },
    { "command": { "action": "splitPane", "split": "right" }, "id": "User.splitRight" },
    { "command": { "action": "splitPane", "split": "down" }, "id": "User.splitDown" },
    { "command": { "action": "moveFocus", "direction": "left" }, "id": "User.moveFocusLeft" },
    { "command": { "action": "moveFocus", "direction": "right" }, "id": "User.moveFocusRight" },
    { "command": { "action": "moveFocus", "direction": "up" }, "id": "User.moveFocusUp" },
    { "command": { "action": "moveFocus", "direction": "down" }, "id": "User.moveFocusDown" },
    { "command": "togglePaneZoom", "id": "User.togglePaneZoom" }
  ],
  "keybindings": [
    { "keys": "alt+1", "id": "User.switchToTab0" },
    { "keys": "alt+2", "id": "User.switchToTab1" },
    { "keys": "alt+3", "id": "User.switchToTab2" },
    { "keys": "alt+4", "id": "User.switchToTab3" },
    { "keys": "ctrl+shift+e", "id": "User.splitRight" },
    { "keys": "ctrl+shift+o", "id": "User.splitDown" },
    { "keys": "ctrl+shift+left", "id": "User.moveFocusLeft" },
    { "keys": "ctrl+shift+right", "id": "User.moveFocusRight" },
    { "keys": "ctrl+shift+up", "id": "User.moveFocusUp" },
    { "keys": "ctrl+shift+down", "id": "User.moveFocusDown" },
    { "keys": "ctrl+shift+z", "id": "User.togglePaneZoom" }
  ]
}
