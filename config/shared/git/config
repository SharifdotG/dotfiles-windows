# ~/.config/git/config - copied into place by install.ps1. Edit the repo copy.
#
# Git reads TWO global config files: this one ($XDG_CONFIG_HOME/git/config -
# %USERPROFILE%\.config\git\config on Windows), then ~/.gitconfig, whose values win.
#
#   this file     owned by the repo; install.ps1 replaces it on every run
#   ~/.gitconfig  owned by you; holds your name and email. install.ps1 creates it
#                 once and never replaces it. Because it exists, `git config
#                 --global ...` and GitHub Desktop write there too - so nothing
#                 they write is lost when install.ps1 runs again.
#
# NB: don't delete ~/.gitconfig. Without it, `git config --global` writes into
# THIS file instead, and the next install.ps1 run silently throws that away.

[init]
	defaultBranch = main
[pull]
	rebase = true
[core]
	editor = code-insiders --wait
	# Large monorepos: these make status/diff noticeably faster. On Windows,
	# fsmonitor runs git's built-in watcher daemon - one small process for each
	# repo you actively work in.
	fsmonitor = true
	untrackedCache = true
	# NB: never let git rewrite line endings. Git for Windows' installer default
	# (autocrlf=true) checks shell scripts out with CRLF, and a script that is
	# bind-mounted or COPY'd into a Linux container then dies with
	#     $'\r': command not found
	# SocialHousingOSS/logging bind-mounts ./setup-kibana.sh exactly like that.
	# A repo that really wants CRLF says so in its own .gitattributes.
	autocrlf = false
	# node_modules trees routinely pass the 260-character MAX_PATH. tune.ps1
	# enables long paths in Windows itself; this is git's half of the same fix.
	longpaths = true
[feature]
	manyFiles = true
[index]
	# NB: manyFiles implies index.skipHash=true, which writes an index with a
	# zeroed trailing checksum. Git itself is fine with it; libgit2 is not, and
	# GitKraken (configured in the VS Code settings) is a libgit2 client - it
	# fails to open the repo with a checksum error that reads like corruption.
	# Pin it off explicitly rather than inheriting it from the feature bundle.
	skipHash = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Credentials: deliberately nothing here. Git for Windows installs Git Credential
# Manager as the system-wide helper (C:\Program Files\Git\etc\gitconfig); it signs
# in through the browser on the first push and keeps the result in Windows
# Credential Manager. GitHub Desktop signs in on its own. A helper set in this
# file would override both.
